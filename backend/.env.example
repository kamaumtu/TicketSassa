# Local MongoDB. Set MONGODB_URI to your Atlas connection string to use Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/talanta_ticketsasa

# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:4200,http://localhost:8000,http://127.0.0.1:8000

# For production, supply your Safaricom Daraja Express credentials and set PAYMENT_MODE=live.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=
PAYMENT_MODE=disabled

# Optional secret for authorized gate scanners. Leave blank to disable ticket redemption.
PASS_SCANNER_KEY=talanta-scanner-demo-key-2026
# Private organizer publishing key. Leave empty to disable publishing.
ORGANIZER_KEY=OQqGfiOTN5IqBCHcmT2Refiw9PbdwtwX51q4ysxgnf4

# PayHero M-Pesa Integration
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=
PAYHERO_CALLBACK_TOKEN=

# Nexus Pay (Makamesco Pay) STK Integration
