{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "talanta-ticketsasa": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/talanta-ticketsasa",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "kenya-event-catalog.js", "input": "src", "output": "." }]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": { "fonts": false }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "talanta-ticketsasa:build:production"
            },
            "development": {
              "buildTarget": "talanta-ticketsasa:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
